# Build the pinned upstream assembler without its Unix-only CMake/gettext setup.
SRC=.tools\source\z80asm\src
INC=.tools\source\z80asm\include
OUT=build\tools\z80asm.exe
COMPAT=tooling\z80asm-msvc
POSIX=tooling\z80dasm-msvc

SOURCES=$(SRC)\main.c $(SRC)\files.c $(SRC)\stack.c $(SRC)\z80asm.c $(SRC)\expressions.c $(SRC)\stringstore.c $(SRC)\error.c

all: $(OUT)

$(OUT): $(SOURCES) $(COMPAT)\compat.h $(COMPAT)\search.h $(COMPAT)\strings.h $(POSIX)\getopt.h $(POSIX)\unistd.h
	cl /nologo /O2 /W3 /I$(COMPAT) /I$(POSIX) /I$(INC) /FIcompat.h $(SOURCES) /Fobuild\tools\ /Fe:$(OUT)
