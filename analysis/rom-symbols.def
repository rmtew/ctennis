; Start of cartridge execution.
reset_entry: equ 0x0000
; VDP interrupt entry point.
irq_vector: equ 0x0038
; Install the regular work routine for subsequent interrupts.
set_irq_callback: equ 0x001b
; Collect controls for play and menu selection.
read_game_input: equ 0x087e
read_menu_selection_bits: equ 0x0890
; Advance the menu state and decide when selection input is accepted.
menu_state_poll: equ 0x012e
menu_input_gate: equ 0x0168
; Run-length encoded colours for the initial background.
background_color_runs: equ 0x01c3

; Display configuration and title-screen records.
initial_vdp_register_values: equ 0x02dc
title_bitmap_masks: equ 0x0376
title_tile_strings: equ 0x03ba
initial_name_layout_data: equ 0x0482
title_tile_triplets: equ 0x0553
; Pause during the title transition.
title_phase_wait: equ 0x01bc
; Advance shared clocks and schedule sound during an interrupt.
irq_counter_update: equ 0x06b1
; Initial playback state copied to each sound channel.
audio_channel_template: equ 0x17b9

; Base tone periods selected by note commands.
psg_pitch_table: equ 0x18da

; Routes stream commands to the corresponding sound operation.
audio_command_dispatch: equ 0x185b

; Service all three tone channels when the audio countdown expires.
audio_tick_three_channels: equ 0x17c5
; Locate the playback record for the selected tone channel.
audio_channel_record_from_b: equ 0x198d
; Fetch the next sound command or signal the stream's stop point.
audio_fetch_next_command: equ 0x199c
; Apply the lower player's directional movement.
lower_player_motion_update: equ 0x1404
bounded_left_step: equ 0x1435
; Alternate movement step size using interrupt-tick parity.
movement_step_from_irq_parity: equ 0x148c

; Classify the completed rally and update the selected player's score.
resolve_point_outcome: equ 0x098f
increment_selected_score: equ 0x0a30
; Both players use mirrored proximity and height gates for a return.
lower_player_ball_contact: equ 0x0bf3
upper_player_ball_contact: equ 0x0f19
ball_player_proximity_test: equ 0x1770
; Sprite graphics loaded into video memory during startup.
sprite_pattern_source: equ 0x19cc
; Background graphics repeated across the three display bands.
background_pattern_source: equ 0x1c4c
; Send the selected channel's attenuation to the PSG.
write_psg_volume_latch: equ 0x197d
; Silence all three tone channels.
mute_psg_tone_channels: equ 0x1974
; Shared game-state fields in system RAM.
irq_tick_counter: equ 0xc06b
; Mode and transition flags also determine whether live input is accepted.
mode_status_flags: equ 0xc03d
; Point-display states for the two sides, including deuce-like and advantage states.
score_a_units: equ 0xc03e
score_b_units: equ 0xc03f
; Ball-motion and player-phase flags select work for each gameplay update.
ball_motion_flags: equ 0xc038
point_outcome_flags: equ 0xc039
ball_phase_flags: equ 0xc03a
shared_phase_timer: equ 0xc06c
audio_tick_countdown: equ 0xc083
audio_channel_records: equ 0xc085
; Player positions are used for movement, drawing and ball-contact tests.
upper_player_y: equ 0xc045
upper_player_x: equ 0xc046
lower_player_y: equ 0xc049
; Lower player's position changes with its accepted movement input.
lower_player_x: equ 0xc04a
; Logical court position and drawn sprite position are calculated separately;
; contact and court tests use the former, while sprite construction uses the latter.
ball_court_y: equ 0xc034
ball_court_x: equ 0xc035
ball_sprite_y: equ 0xc04d
ball_sprite_x: equ 0xc04e
; A prepared launch trajectory becomes active when flight starts;
; the step counter tracks progress through that flight.
ball_launch_trajectory: equ 0xc057
ball_flight_trajectory: equ 0xc060
ball_flight_step: equ 0xc066

